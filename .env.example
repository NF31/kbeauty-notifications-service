PORT=3000

# Compte RabbitMQ dedie, droits limites a ses propres files (voir
# kbeauty-ecosystem/rabbitmq/creer-comptes.sh).
RABBITMQ_URL=amqp://notifications:notifications@localhost:5672

# Si absent, les emails sont journalises au lieu d'etre envoyes (dev local
# sans compte Resend).
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL="Korea Beauty <no-reply@kbeauty-shop.test>"

# Chemin de la base SQLite de deduplication (par defaut : ./data/notifications.sqlite)
NOTIFICATIONS_DB_PATH=
